package com.example.demo.controller;

import java.util.List;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.messaging.handler.annotation.MessageMapping;
import org.springframework.messaging.simp.SimpMessageHeaderAccessor;
import org.springframework.messaging.simp.SimpMessagingTemplate;
import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.GetMapping;

import com.example.demo.dto.ObjectState;
import com.example.demo.dto.PlayerHitMessage;
import com.example.demo.dto.PlayerState;
import com.example.demo.service.PlayerService;

@Controller
public class GameController {

	private static final Logger logger = LoggerFactory.getLogger(GameController.class);
	private final SimpMessagingTemplate messagingTemplate;
	private final PlayerService playerService;

	public GameController(SimpMessagingTemplate messagingTemplate, PlayerService playerService) {
		this.messagingTemplate = messagingTemplate;
		this.playerService = playerService;
	}

	@GetMapping("/api/hello")
	public String hello() {
		//logger.info("Hello from Spring Boot server (HTTP request)!");
		return "Hello from Spring Boot!";
	}

	@MessageMapping("/registerPlayer")
	public void registerPlayer(PlayerState playerState, SimpMessageHeaderAccessor headerAccessor) {
		String sessionId = headerAccessor.getSessionId();
		playerService.addPlayer(playerState, sessionId);

		// 새로운 플레이어의 ID를 클라이언트에 다시 전송 (확인용 또는 초기 설정용)
		// 클라이언트에서는 이 ID를 localStorage에 저장하여 다음 접속 시 사용
		messagingTemplate.convertAndSendToUser(
				sessionId, "/queue/player.id", playerState.getId());

		// 모든 클라이언트에게 업데이트된 전체 플레이어 목록을 브로드캐스팅합니다.
		messagingTemplate.convertAndSend("/topic/playerLocations", playerService.getAllPlayers());
	}

	@MessageMapping("/player.move")
	public void movePlayer(PlayerState playerState) {
		// 플레이어 서비스에 플레이어 상태 업데이트 요청
		playerService.updatePlayerState(playerState);
		// 업데이트된 전체 플레이어 목록을 다시 모든 클라이언트에게 브로드캐스팅합니다.
		messagingTemplate.convertAndSend("/topic/playerLocations", playerService.getAllPlayers());
	}
	
	@MessageMapping("/sceneObjects")
	public void updateObjectState(List<ObjectState> objectStates) {
	    // 모든 클라이언트에게 브로드캐스트
	    messagingTemplate.convertAndSend("/topic/sceneObjects", objectStates);
	}
	
	@MessageMapping("/playerHit")
	public void handlePlayerHit(PlayerHitMessage message) {
	    // 브로드캐스트: 모든 클라이언트가 피격 알 수 있도록
	    messagingTemplate.convertAndSend("/topic/playerHit", message);
	}

	/**
	 * 플레이어의 인벤토리 업데이트 요청을 처리합니다.
	 * 클라이언트가 아이템을 획득하거나 사용할 때 이 메시지를 보냅니다.
	 * @param playerState 업데이트된 인벤토리 정보를 포함한 플레이어 상태
	 */
	@MessageMapping("/inventory.update") // 새로운 MessageMapping 추가
	public void updateInventory(PlayerState playerState) {
		if (playerState.getId() == null || playerState.getId().isEmpty()) {
			logger.warn("Received inventory update for player with null or empty ID.");
			return;
		}

		// PlayerService를 통해 해당 플레이어의 인벤토리를 업데이트합니다.
		// PlayerState 전체를 넘겨서 서비스에서 인벤토리만 추출하여 업데이트하도록 할 수도 있고,
		// InventoryItem 리스트만 별도로 받는 DTO를 만들 수도 있습니다.
		// 여기서는 PlayerState 전체를 받아 PlayerService에서 처리하도록 합니다.
		PlayerState updatedPlayer = playerService.updatePlayerInventory(
			playerState.getId(),
			playerState.getInventory() != null ? playerState.getInventory() : List.of() // null 체크 및 빈 리스트 처리
		);

		if (updatedPlayer != null) {
			// 인벤토리가 업데이트된 플레이어의 상태를 모든 클라이언트에게 브로드캐스팅
			// PlayerState에 인벤토리 정보가 포함되어 있으므로, 기존 /topic/playerLocations를 사용해도 됩니다.
			// 다만, 인벤토리 변경만을 위한 별도의 토픽을 만들 수도 있습니다.
			// 여기서는 기존 playerLocations 토픽을 재사용하여 PlayerState 전체를 보냅니다.
			messagingTemplate.convertAndSend("/topic/playerLocations", playerService.getAllPlayers());
			logger.info("Player {}'s inventory updated and broadcasted.", updatedPlayer.getId());
		} else {
			logger.warn("Failed to update inventory for player ID: {}", playerState.getId());
		}
	}

	/**
	 * 웹소켓 연결이 끊어졌을 때 호출되는 메서드. 이 메서드는 WebSocketEventListener의
	 * SessionDisconnectEvent에서 호출됩니다.
	 *
	 * @param sessionId 연결이 끊긴 세션의 ID
	 */
	public void unregisterPlayer(String sessionId) {
		// PlayerService를 통해 플레이어 제거
		playerService.removePlayerBySessionId(sessionId);
		// 모든 클라이언트에게 업데이트된 플레이어 목록을 브로드캐스트
		// (끊긴 플레이어가 제거된 상태로 전송)
		messagingTemplate.convertAndSend("/topic/playerLocations", playerService.getAllPlayers());
	}
}