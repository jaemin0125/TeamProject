import com.example.demo.dto.AnimationState;
import com.example.demo.dto.Item;
import com.example.demo.dto.ObjectState;
import com.example.demo.dto.PlayerState;
import com.example.demo.dto.PlayerState.Position;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;
import org.springframework.messaging.simp.SimpMessagingTemplate; // SimpMessagingTemplate 주입을 위해 추가

import javax.annotation.PostConstruct; // @PostConstruct 임포트

import java.util.Collection;
import java.util.concurrent.ConcurrentHashMap;
import java.util.Map;
import java.util.UUID;
import java.util.Optional;

@Service
public class PlayerService {

    private static final Logger logger = LoggerFactory.getLogger(PlayerService.class);

    private final Map<String, PlayerState> connectedPlayers = new ConcurrentHashMap<>();
    private final Map<String, String> sessionToPlayerIdMap = new ConcurrentHashMap<>();
    private final Map<String, ObjectState> sceneObjects = new ConcurrentHashMap<>();

    // ✨ SimpMessagingTemplate 추가 (웹소켓 메시지 전송용)
    private final SimpMessagingTemplate messagingTemplate;

    // ✨ 생성자 수정: PlayerService가 생성될 때 SimpMessagingTemplate을 주입받도록 합니다.
    // addInitialApple() 호출은 @PostConstruct로 이동합니다.
    public PlayerService(SimpMessagingTemplate messagingTemplate) {
        this.messagingTemplate = messagingTemplate;
    }

    // ✨ 서버 시작 시 단 한 번만 실행되도록 @PostConstruct 사용
    @PostConstruct
    public void init() {
        addInitialApple();
    }

    // 기존의 addInitialApple 메소드는 그대로 유지합니다.
    private void addInitialApple() {
        String appleId = UUID.randomUUID().toString(); // 사과 ID 생성
        Position applePosition = new Position(0, 1.0, -5); // 사과 위치
        // 사과 오브젝트 생성 (isPickable 필드 제거, itemType으로 대체)
        ObjectState apple = new ObjectState(
            appleId,
            applePosition,
            "apple", // objectType: 'apple'
            "/models/apple.glb", // modelPath
            "APPLE" // itemType: 이 오브젝트가 사과 아이템임을 나타냄
        );
        sceneObjects.put(appleId, apple);
        logger.info("Initial apple added to scene: {}", apple.getId());
    }

    // ... (기존 메소드들: addPlayer, removePlayerBySessionId, updatePlayerState, getAllPlayers, getPlayerById)

    // ✨ 새로 추가: 씬 오브젝트 리스트 반환 메소드
    public Collection<ObjectState> getAllSceneObjects() {
        return sceneObjects.values();
    }

    /**
     * 씬에서 아이템을 주워 플레이어 인벤토리에 추가하고 씬에서 제거합니다.
     * @param playerId 아이템을 줍는 플레이어의 ID
     * @param objectId 주울 씬 오브젝트의 ID (사과 등)
     * @return 성공 여부
     */
    public boolean pickUpItemFromScene(String playerId, String objectId) {
        PlayerState player = connectedPlayers.get(playerId);
        ObjectState objectToPick = sceneObjects.get(objectId);

        if (player == null) {
            logger.warn("Pick up failed: Player {} not found.", playerId);
            return false;
        }
        if (objectToPick == null) {
            logger.warn("Pick up failed: Object {} not found in scene.", objectId);
            return false;
        }

        // 아이템 타입이 정의된 오브젝트만 주울 수 있도록 가정
        if (objectToPick.getItemType() == null || objectToPick.getItemType().isEmpty()) {
            logger.warn("Pick up failed: Object {} is not a pickable item.", objectId);
            return false;
        }

        // 아이템 정보 생성 (여기서는 예시로 사과를 가정)
        // 실제 게임에서는 objectToPick의 itemType에 따라 다른 Item DTO를 생성해야 할 수 있습니다.
        Item newItem = null;
        if ("APPLE".equals(objectToPick.getItemType())) {
            // 사과 아이템 생성 (ID는 새로 생성하거나 기존 ObjectState ID를 활용)
            newItem = new Item(UUID.randomUUID().toString(), "사과", "food", 1, "/assets/apple.png", 20.0);
        } else {
             logger.warn("Unknown item type for object {}: {}", objectId, objectToPick.getItemType());
             return false;
        }

        if (newItem != null) {
            // 인벤토리에 추가 (간단한 로직, 실제로는 중복 처리 등 필요)
            player.getInventory().add(newItem);
            logger.info("Player {} picked up item {} ({}).", playerId, newItem.getName(), objectId);

            // 씬에서 오브젝트 제거
            sceneObjects.remove(objectId);
            logger.info("Object {} removed from scene.", objectId);

            // ✨ 중요: 씬 오브젝트 목록 변경을 모든 클라이언트에게 브로드캐스트
            messagingTemplate.convertAndSend("/topic/sceneObjects", getAllSceneObjects());
            // 플레이어 상태(인벤토리) 변경도 브로드캐스트
            messagingTemplate.convertAndSend("/topic/playerLocations", getAllPlayers());

            return true;
        }
        return false;
    }

    // ... (기존 useItemFromPlayerInventory, setPlayerHealth 등 메소드)
}